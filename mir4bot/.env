# Renomeie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA compartilhe seu token do bot com ninguém.

DISCORD_TOKEN=

# ID do servidor (guild) onde o bot vai operar. Ative o "Modo Desenvolvedor"
# no Discord (Config > Avançado) para conseguir copiar IDs com o botão direito.
GUILD_ID=
# ID do cargo (role) que vai atender os tickets (equipe de vendas)
STAFF_ROLE_ID=

# ID da categoria onde os canais de ticket serão criados
TICKET_CATEGORY_ID=

# ID do canal onde o painel de compra (embed com botão) vai ser postado
PAINEL_CHANNEL_ID=

# Link para os termos de uso / políticas mostrado antes do pagamento.
# Troque pelo link real quando tiver um (ex: Google Docs, site).
TERMOS_URL=https://docs.google.com/document/d/SEU-LINK-AQUI/edit

# ID do canal onde o histórico (transcript) de cada ticket fechado é enviado.
ARQUIVO_CHANNEL_ID=
